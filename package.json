{
  "name": "proanchat-desktop",
  "version": "1.0.0",
  "description": "Proanchat Desktop App for Windows with automatic updates",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.proanchat.desktop",
    "productName": "Proanchat",
    "artifactName": "Proanchat-Setup.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Proanchat"
    },
    "publish": [
      {
        "provider": "github"
      }
    ]
  }
}
